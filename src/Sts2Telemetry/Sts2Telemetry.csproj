<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Sts2Telemetry</AssemblyName>
    <RootNamespace>Sts2Telemetry</RootNamespace>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">D:\SteamLibrary\steamapps\common\Slay the Spire 2</STS2GameDir>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</STS2GameDir>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Slay the Spire 2')">$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Slay the Spire 2</STS2GameDir>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2</STS2GameDir>
    <STS2MacResourcesDir Condition="'$(STS2MacResourcesDir)' == ''">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources</STS2MacResourcesDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(STS2MacResourcesDir)/data_sts2_macos_arm64')">$(STS2MacResourcesDir)/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('$(STS2MacResourcesDir)/data_sts2_macos_x86_64')">$(STS2MacResourcesDir)/data_sts2_macos_x86_64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(STS2MacResourcesDir)/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(STS2GameDir)/data_sts2_linuxbsd_x86_64</STS2GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Sts2Telemetry.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
